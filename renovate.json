{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Africa/Johannesburg",
  "schedule": [
    "before 6am on monday"
  ],
  "labels": [
    "area:dependencies"
  ],
  "prConcurrentLimit": 10,
  "enabledManagers": [
    "github-actions",
    "npm",
    "composer"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "addLabels": [
        "github_actions"
      ]
    },
    {
      "groupName": "wordpress",
      "matchPackageNames": [
        "@wordpress/**"
      ]
    }
  ]
}
